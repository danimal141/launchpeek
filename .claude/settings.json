{
  "permissions": {
    "allow": [
      "Bash(bun run lint)",
      "Bash(bun run format)",
      "Bash(bun run typecheck)",
      "Bash(bun test)",
      "Bash(bun test *)",
      "Bash(bun run test:e2e)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; bunx biome check --write --no-errors-on-unmatched \"$f\"; } >/dev/null 2>&1 || true",
            "statusMessage": "Formatting with Biome"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify.sh",
            "timeout": 120,
            "statusMessage": "Running lint, typecheck, and tests"
          }
        ]
      }
    ]
  }
}
